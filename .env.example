# Copie este arquivo para .env.local (não versionado) e preencha com os
# valores do seu projeto Supabase (Settings > API).
# NUNCA coloque a Service Role Key em variáveis com prefixo NEXT_PUBLIC_.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Chaves públicas, usadas pelo painel admin (login/autenticação).
# É seguro expor essas duas no navegador — não são segredos.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-publishable-key-aqui

# E-mail transacional (Resend). A chave é um segredo: só no servidor
# (variável de ambiente da Vercel), nunca com prefixo NEXT_PUBLIC_.
# Sem RESEND_API_KEY o site funciona normalmente, apenas não envia e-mails.
RESEND_API_KEY=re_coloque-a-chave-aqui
# Opcionais (os padrões já usam acolhimento@igrejanovaterra.com.br):
# EMAIL_FROM="Igreja Nova Terra <acolhimento@igrejanovaterra.com.br>"
# EMAIL_NOTIFY_TO=acolhimento@igrejanovaterra.com.br
